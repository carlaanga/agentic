# Copia este archivo a .env si quieres cambiar el modelo.
# Debe ser un modelo con soporte de herramientas (tool calling) y que quepa en tu máquina.
#   qwen3:4b      ~2.5 GB, corre en CPU con 8 GB de RAM   (por defecto)
#   llama3.2:3b   ~2.0 GB, alternativa más ligera
#   qwen3:8b      ~5 GB, más fiable si tienes 16 GB de RAM o GPU
MODELO=qwen3:4b
